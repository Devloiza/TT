venv/
venv-*/
__pycache__/
.vscode/
Citas.md
PROTOCOLO_TT.pdf

# Resultados generados (grabaciones .npy, gráficas, etc.) — no versionar,
# solo el marcador de la carpeta (ver SALIDAS/README.md)
SALIDAS/*
!SALIDAS/README.md
# Configuración personal de Claude Code por máquina (la compartida es .claude/settings.json)
.claude/settings.local.json

# LaTeX (Escrito/): auxiliares de compilación y PDFs, que se regeneran desde los .tex
Escrito/**/*.aux
Escrito/**/*.log
Escrito/**/*.fls
Escrito/**/*.fdb_latexmk
Escrito/**/*.synctex.gz
Escrito/**/*.out
Escrito/**/*.toc
Escrito/**/*.bbl
Escrito/**/*.blg
Escrito/**/*.pdf
