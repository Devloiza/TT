venv/
venv-*/
__pycache__/
.vscode/
Citas.md
PROTOCOLO_TT.pdf

# Resultados generados (grabaciones .npy, gráficas, etc.) — no versionar,
# solo el marcador de la carpeta (ver SALIDAS/README.md)
SALIDAS/*
!SALIDAS/README.md
# Configuración personal de Claude Code por máquina (la compartida es .claude/settings.json)
.claude/settings.local.json

# LaTeX (Escrito/): auxiliares de compilación, que se regeneran desde los .tex
Escrito/**/*.aux
Escrito/**/*.log
Escrito/**/*.fls
Escrito/**/*.fdb_latexmk
Escrito/**/*.synctex.gz
Escrito/**/*.out
Escrito/**/*.toc
Escrito/**/*.lof
Escrito/**/*.lot
Escrito/**/*.bbl
Escrito/**/*.blg
Escrito/**/*.idx
Escrito/**/*.ind
Escrito/**/*.ilg
Escrito/**/*.nlo
Escrito/**/*.nls
Escrito/**/*.eix
Escrito/**/*.nlg
Escrito/**/*.lol
Escrito/**/*.loa
Escrito/**/*.bcf
Escrito/**/*.run.xml
Escrito/**/*.xdv
Escrito/**/*.dvi
Escrito/**/*.synctex(busy)
Escrito/**/*.auxlock
# Solo el PDF compilado de cada documento (tesina/, pruebas/); los PDF de logos/ e imagenes/ sí se versionan
Escrito/*/*.pdf
# Copia comprimida de la plantilla original: duplica lo que ya está en tesina/ (se conserva local)
Escrito/TT_UPIITA_2023.zip
# Material de consulta de la plantilla (manuales y diccionarios); no se compila (PLANTILLA.md, P23; se conserva local)
Escrito/tesina/adicionales/
