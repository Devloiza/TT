# Configuración de latexmk para la tesina (la usa LaTeX Workshop al compilar).
# La nomenclatura (paquete nomencl) necesita correr makeindex con el estilo
# nomencl.ist; latexmk no lo hace por sí solo y la página saldría vacía.
add_cus_dep('nlo', 'nls', 0, 'nlo2nls');
sub nlo2nls {
    system("makeindex \"$_[0].nlo\" -s nomencl.ist -o \"$_[0].nls\"");
}
push @generated_exts, 'nlo', 'nls', 'ilg';
